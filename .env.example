# ==========================================================
# IG DOWNLOADER - ENVIRONMENT CONFIGURATION
# ==========================================================

# 1. URL Domain Aplikasi (untuk Canonical & OpenGraph SEO)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 2. RAPIDAPI FALLBACK (Sangat Direkomendasikan untuk Production Hosting)
# Jika server hosting Anda (seperti Vercel, AWS, DigitalOcean) terkena limit IP oleh Instagram,
# sistem akan otomatis beralih ke RapidAPI ini.
# Daftar gratis & dapatkan API Key di: https://rapidapi.com/
RAPIDAPI_KEY=""
RAPIDAPI_HOST="instagram-downloader-download-instagram-videos-stories4.p.rapidapi.com"

# 3. KREDENSIAL SESI INSTAGRAM (OPSIONAL - Untuk Metode Native Tanpa RapidAPI)
# Anda bisa mengisi sessionid dari cookie browser untuk scraper native GraphQL:
# Contoh: sessionid=672839210%3AAbCdEf123...
INSTAGRAM_COOKIE=""
INSTAGRAM_SESSION_ID=""
